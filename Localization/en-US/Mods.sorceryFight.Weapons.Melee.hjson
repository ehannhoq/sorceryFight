	DisplayName: Jet-Black Shadow Sword
	Tooltip: A jet black cursed tool with great cutting power
}

FesteringLifeBlade: {
	DisplayName: Festering Life Sword
	Tooltip: A short cleaver-like blade festering with life and death
}

MeiMeiAxe: {
	DisplayName: Giant Battle Axe
	Tooltip: A ginormous cursed battle axe
}

DragonBone: {
	DisplayName: Dragon-Bone
	Tooltip: The finest blade ever forged by Juzo Kumiya
}

BlackRope: {
	DisplayName: Black Rope
	Tooltip: A Rope that nullifies anything
}

QueensBlade: {
	DisplayName: Queen's Blade
	Tooltip: A blade forged by the Queen of curses. Every fourth hit she punches the target.
}

InvertedSpear: {
	DisplayName: Inverted Spear of Heaven
	Tooltip:
		'''
		Imbued with a foreign cursed technique, it's blade can nullify any cursed
		technique.
		[c/E0DA5A:Right click to toggle to a swinging charge up, which upon]
		[c/E0DA5A:releasing throws out the spear for an undefined distance]
		'''
}

Kamutoke: {
	DisplayName: Supreme Martial Solution
	Tooltip:
		'''
		An ancient cursed tool imbued with lighting
		[c/E0DA5A:Right click to fire lightning at enemies, each hit chaining to more enemies]
		'''
}

CrikySword: {
	DisplayName: Subatomic Particle Splitter
	Tooltip:
		'''
		A blade that splits through the subatomic particles that make up atoms
		[c/6D2673:Dedicated to TheRealCriky]
		'''
}

ObliviousSword: {
	DisplayName: The Resonant
	Tooltip:
		'''
		[c/EBE3B2:An ancient blade of unknown origins. Said to scale its own strength to its wielder's strength]
		Bosses slain: [BOSSES]
		Increased damage: [DAMAGE]
		Increased crit chance: [CRIT]%
		[c/808080:'The wielder of this sword fought the flames of Jungle terror to prevail.]
		[c/808080:The gods granted him this sword to mark his achievement. It is said that]
		[c/808080:this sword will bring Oblivion to those who are Oblivious to its power.']
		[c/6D2673:Dedicated to ObliviousOblivion]
		'''
}

ChakiraResonant: {
	DisplayName: The Chakira Resonant
	Tooltip:
		'''
		[c/EBE3B2:An ancient blade of unknown origins. Said to scale its own strength to its wielder's strength]
		[c/EBE3B2:Holding RMB charges cursed energy into the blade, building up into a massive charged attack]
		Bosses slain: [BOSSES]
		Increased damage: [DAMAGE]
		Increased crit chance: [CRIT]%
		[c/808080:'The wielder of this sword fought the flames of Jungle terror to prevail.]
		[c/808080:The gods granted him this sword to mark his achievement. It is said that]
		[c/808080:this sword will bring Oblivion to those who are Oblivious to its power.']
		[c/6D2673:Dedicated to ObliviousOblivion]
		'''
}
